APP_NAME=Nextward
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nextward
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set to true in production (HTTPS only).
SESSION_SECURE_COOKIE=false

# Build with Node.js 24 and supervise php artisan inertia:start-ssr separately.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_ENSURE_RUNTIME_EXISTS=false
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=true
INERTIA_SSR_THROW_ON_ERROR=false

# Email requires explicit candidate consent and a configured mail provider.
OPPORTUNITY_DIGESTS_ENABLED=false
OPPORTUNITY_MAX_AGE_DAYS=30
OPPORTUNITY_RETENTION_DAYS=60
# AI reads new listings and finds new sources; leave the key empty to use the keyword rules only
# Provider: openai or anthropic
OPPORTUNITY_AI_PROVIDER=openai
OPPORTUNITY_AI_TRANSLATE=true
OPENAI_API_KEY=
OPPORTUNITY_OPENAI_MODEL=gpt-5.4-mini
OPPORTUNITY_OPENAI_DISCOVERY_MODEL=gpt-5.5
OPPORTUNITY_OPENAI_LETTER_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
OPPORTUNITY_AI_MODEL=claude-opus-5-5

# Optional. Credentials must be a private server file, never a public asset.
GOOGLE_INDEXING_ENABLED=false
GOOGLE_INDEXING_CREDENTIALS=
GOOGLE_INDEXING_DAILY_LIMIT=200

# Comma separated brand profile links (LinkedIn, Facebook, Instagram...)
NEXTWARD_SOCIAL_LINKS=
# Any 32+ character key; leave empty to turn IndexNow pings off
INDEXNOW_KEY=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Empty: uses Resend when RESEND_API_KEY is set, otherwise writes mail to the log.
MAIL_MAILER=
RESEND_API_KEY=
MAIL_FROM_ADDRESS=nextward@alabaganne.com
MAIL_FROM_NAME="${APP_NAME}"
# Contact form messages go here (defaults to MAIL_FROM_ADDRESS).
MAIL_CONTACT_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Credits for AI work (kits, resume translations and reads). Packs go on sale once prices and a payment provider are set.
BILLING_ENABLED=true
BILLING_SIGNUP_CREDITS=20
BILLING_MONTHLY_CREDITS=5
BILLING_REWRITES_PER_KIT=3
# Prices in millimes (TND) and cents (USD)
BILLING_STARTER_TND=
BILLING_STARTER_USD=
BILLING_STANDARD_TND=
BILLING_STANDARD_USD=
BILLING_PRO_TND=
BILLING_PRO_USD=
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_BASE_URL=https://api.sandbox.konnect.network/api/v2
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_SIGNING_SECRET=
LEMONSQUEEZY_TEST_MODE=true
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_STANDARD=
LEMONSQUEEZY_VARIANT_PRO=

# Resume and letter PDFs (headless Chrome). Leave empty to find Chrome on its own.
CV_CHROME_PATH=
CV_CHROME_NO_SANDBOX=false
